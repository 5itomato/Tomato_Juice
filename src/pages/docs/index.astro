---
import { Button, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { docsSidebar, integ, theme } from '@/site-config'

import DocsContents from './DocsContents.astro'

const meta = {
  title: docsSidebar.title,
  description: `${docsSidebar.title} for ${theme.title}`
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>{theme.title} {docsSidebar.title}</h1>
    </div>

    <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <h2 class='text-xl font-medium'>Browse by topic</h2>
      <DocsContents title={false} />

      <h2 class='text-xl font-medium'>Feedback</h2>
      <p>
        If you encounter any problems, please check <a
          href='https://github.com/5itomato/Tomato_Juice/issues'
          target='_blank'>Github Issues</a
        > or submit a new issue.
      </p>
      <h2 class='text-xl font-medium'>Docs RSS</h2>
      <p>
        <a href='/docs/rss.xml' target='_blank'><Icon name='rss' /> </a>
      </p>
    </div>
  </main>
</PageLayout>
